# .streamlit/secrets.toml にコピーして値を入れる。secrets.toml はリポジトリに含めない
# Supabase なしで画面だけ動かすなら demo = true にする（url と anon_key は空でよい）
demo = false

[supabase]
url = "https://xxxxxxxx.supabase.co"
anon_key = "eyJ..."

[rakuten]
application_id = ""   # 楽天ウェブサービスのアプリID。空ならダミー価格を使う

[llm]
api_key = ""        # 空ならルール変換。OpenAI互換のチャットAPIのキー
base_url = "https://api.openai.com/v1"
model = "gpt-4o-mini"
